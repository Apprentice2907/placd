# ============================================================
# Placd Frontend — Required Environment Variables
# Copy this file to .env.local for local dev.
# Set these as Environment Variables in Vercel dashboard for production.
# NEVER commit the actual .env.local file.
# ============================================================

# -----------------------------------------------------------
# API URL (Required)
# Point to your Koyeb backend URL in production.
# Example: https://placd-api-xxxx.koyeb.app/api
# -----------------------------------------------------------
VITE_API_URL=http://localhost:8000/api
