# Database
# Note: For Docker, use postgres as hostname if running via compose
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@postgres:5432/placd

# Redis
# Note: For Docker, use redis as hostname
REDIS_URL=redis://redis:6379/0

# API Keys
SERPAPI_KEY=your_serpapi_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Security
SECRET_KEY=your_super_secret_key_change_in_production
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173,https://yourdomain.com

# Scraping Config
PLAYWRIGHT_ENABLED=true
# Comma-separated list of proxies for Playwright (http://user:pass@host:port)
PROXY_LIST=

# App Config
LOG_LEVEL=INFO
