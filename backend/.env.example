# ============================================================
# Placd Backend — Required Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.
# ============================================================

# -----------------------------------------------------------
# DATABASE (Required)
# -----------------------------------------------------------
# Neon PostgreSQL connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname

# -----------------------------------------------------------
# API SERVER (Required)
# -----------------------------------------------------------
# Port Koyeb (or any host) will bind to. Koyeb injects this automatically.
PORT=8000

# -----------------------------------------------------------
# CORS (Required for production)
# Comma-separated list of allowed frontend origins.
# Example: https://placd.vercel.app,https://www.placd.com
# -----------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------
# SEARCH ENGINE — Typesense (Optional)
# Set TYPESENSE_ENABLED=false to skip and use Postgres FTS.
# -----------------------------------------------------------
TYPESENSE_ENABLED=false
TYPESENSE_API_KEY=your_typesense_api_key
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http

# -----------------------------------------------------------
# CACHE — Redis (Optional)
# Required for rate limiting and dedup LSH persistence.
# Leave blank to run without Redis (graceful degradation).
# -----------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------
# AI / ENRICHMENT (Optional but recommended)
# -----------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=
SERPAPI_KEY=

# -----------------------------------------------------------
# SCRAPERS (Optional — only needed for specific sources)
# -----------------------------------------------------------
APIFY_API_TOKEN=
PLAYWRIGHT_ENABLED=false

# -----------------------------------------------------------
# INTERNAL CRON TRIGGER (Optional — used by old Render setup)
# Not needed if using GitHub Actions for scraping.
# -----------------------------------------------------------
CRON_SECRET=
